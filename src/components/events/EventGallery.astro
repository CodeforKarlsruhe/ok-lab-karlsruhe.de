---
import LightboxImage from '../ui/LightboxImage.astro';

interface Props {
  images: any[];
  eventTitle: string;
}

const { images, eventTitle } = Astro.props;
---

<div class="gallery-section">
  <div class="section-title">Impressionen</div>
  <div class="gallery">
    {images.map((img: any) => {
      const isObj = typeof img === 'object' && img !== null;
      const url = isObj ? img.image || img.url : img;
      const rawAlt = isObj ? img.imageAlt || img.alt || img.copyright || img.metadata : null;
      const normUrl = url ? (url.startsWith('/') ? url : `/${url}`) : '/assets/images/sma.webp';
      return (
        <div class="gallery-item">
          <LightboxImage
            src={normUrl}
            alt={rawAlt || eventTitle}
            loading="lazy"
            metadata={rawAlt && rawAlt !== eventTitle ? rawAlt : undefined}
          />
        </div>
      );
    })}
  </div>
</div>

<style>
  .gallery-section {
    margin-top: 2.5rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .gallery-item {
    position: relative;
    overflow: visible;
  }

  .gallery :global(img) {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
