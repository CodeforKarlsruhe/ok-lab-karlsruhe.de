---
import LightboxImage from '../ui/LightboxImage.astro';

interface Props {
  event: any;
  dayStr?: string;
  monthStr?: string;
  formattedEventDate?: string;
  availableViews: { id: string; label: string }[];
  showViewSelector: boolean;
}

const { event, dayStr, monthStr, formattedEventDate, availableViews, showViewSelector } =
  Astro.props;
---

{event.image && (
  <div class="hero-banner">
    <LightboxImage
      src={'/' + event.image.replace(/^\//, '')}
      alt={event.imageAlt || event.title}
      metadata={event.imageAlt && event.imageAlt !== event.title ? event.imageAlt : undefined}
      dataFallback="/assets/images/sma.webp"
    />
    <div class="hero-overlay"></div>
    {!event.rhythm && dayStr && monthStr && (
      <div class="date-badge">
        <span class="month">{monthStr}</span>
        <span class="day">{dayStr}</span>
      </div>
    )}
  </div>
)}

<div class="header-info">
  <h1>{event.title}</h1>
  <div class="meta-row">
    {event.rhythm ? (
      <div class="meta-item meta-rhythm">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{event.rhythm}</span>
      </div>
    ) : (
      <>
        {formattedEventDate && (
          <div class="meta-item">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>{formattedEventDate}</span>
          </div>
        )}
        {event.time && (
          <div class="meta-item">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 16 14"></polyline>
            </svg>
            <span>{event.time}</span>
          </div>
        )}
      </>
    )}
    {event.location && (
      <div class="meta-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {event.locationUrl ? (
          <a href={event.locationUrl} target="_blank" rel="noopener noreferrer" class="link-inline">
            <span>{event.location}</span> <span class="link-arrow">🡵</span>
          </a>
        ) : (
          <span>{event.location}</span>
        )}
      </div>
    )}
  </div>

  {showViewSelector && (
    <div class="detail-view-switcher" role="tablist" aria-label="Ansicht auswählen">
      {availableViews.map((v, idx) => (
        <button
          type="button"
          class={`view-tab-pill ${idx === 0 ? 'active' : ''}`}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-view-target={v.id}
        >
          {v.label}
        </button>
      ))}
    </div>
  )}
</div>

{event.teaser && <h3>{event.teaser}</h3>}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.detail-view-switcher .view-tab-pill');
    const panels = document.querySelectorAll('.event-detail-page .view-panel');

    if (tabs.length > 0 && panels.length > 0) {
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-view-target');
          tabs.forEach((t) => {
            const isMatch = t === tab;
            t.classList.toggle('active', isMatch);
            t.setAttribute('aria-selected', String(isMatch));
          });
          panels.forEach((p) => {
            const isMatch = p.getAttribute('data-view-panel') === target;
            p.classList.toggle('active', isMatch);
          });
        });
      });
    }
  });
</script>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    height: 380px;
    border-radius: 12px;
    overflow: visible;
    margin-top: 1.5rem;
    background: var(--color-surface-sunken);
  }

  .hero-banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.4));
    pointer-events: none;
  }

  .date-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    background: var(--color-surface-raised, #1c1a18);
    color: var(--color-text, #ffffff);
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    text-align: center;
    font-weight: 600;
    line-height: 1.1;
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .date-badge .month {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    display: block;
    color: var(--color-primary);
  }

  .date-badge .day {
    font-size: 1.5rem;
    display: block;
    font-variant-numeric: tabular-nums;
  }

  .header-info {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.02em;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-rhythm {
    color: var(--color-primary);
    font-weight: 600;
  }

  .detail-view-switcher {
    display: inline-flex;
    background: var(--color-surface-sunken, #f1f5f9);
    padding: 3px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    gap: 3px;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .view-tab-pill {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0.45rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: 6px;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .view-tab-pill:hover {
    color: var(--color-text);
  }

  .view-tab-pill.active {
    background: var(--color-surface, #ffffff);
    color: var(--color-primary);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
  }

  @media (max-width: 600px) {
    .hero-banner {
      height: 250px;
    }

    h1 {
      font-size: 2rem;
    }

    .meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
