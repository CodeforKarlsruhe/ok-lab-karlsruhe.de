---

<div class="view-dropdown" id="view-dropdown">
  <button
    type="button"
    id="view-toggle-btn"
    title="Ansicht umschalten"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <span>Ansicht</span>
    <svg
      class="dropdown-chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <div class="view-menu" id="view-menu">
    <label>
      <input type="radio" name="view-mode" value="true" checked />
      <span>Nach Serien gruppiert</span>
    </label>
    <label>
      <input type="radio" name="view-mode" value="false" />
      <span>Alle Termine zeigen</span>
    </label>
  </div>
</div>

<style>
  .view-dropdown {
    position: relative;
    display: inline-block;
  }

  button {
    padding: 0.35rem 0.75rem;
    height: 32px;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 6px);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 150ms ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  button:hover,
  .view-dropdown.is-open button {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .dropdown-chevron {
    transition: transform 180ms ease;
    opacity: 0.75;
  }

  .view-dropdown.is-open .dropdown-chevron,
  .view-dropdown:has(.view-menu.open) .dropdown-chevron {
    transform: rotate(180deg);
  }

  .view-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: var(--shadow-popover);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 10;
    min-width: 200px;
    text-align: left;
  }

  .view-menu.open {
    display: flex;
  }

  label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    font-size: 0.8rem;
    cursor: pointer;
    border-radius: 4px;
    color: var(--color-text-secondary);
    transition: background 150ms ease;
    white-space: nowrap;
  }

  label:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  input[type='radio'] {
    margin: 0;
    cursor: pointer;
  }
</style>
