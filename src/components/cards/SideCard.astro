---
interface Props {
  title?: string;
  accent?: boolean;
  class?: string;
  [key: string]: any;
}

const { title, accent = false, class: className = '', ...rest } = Astro.props;
---

<article
  class:list={['card', 'side-card', accent ? 'side-card-accent' : 'side-card-default', className]}
  {...rest}
>
  {title && (
    <h3 class="side-card-title">
      <slot name="title">{title}</slot>
    </h3>
  )}
  <div class="side-card-body">
    <slot />
  </div>
</article>

<style>
  .side-card {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background-color: var(--card-bg, var(--color-surface));
    border: 1px solid var(--card-border, var(--color-border));
    border-radius: var(--card-radius, var(--radius-xl, 12px));
    padding: var(--space-6, 1.5rem);
    box-shadow: var(--shadow-card, 0 1px 3px rgba(0, 0, 0, 0.03));
    overflow: visible;
    position: relative;
    transition: none;
  }

  .side-card:hover {
    border-color: var(--card-border, var(--color-border));
    box-shadow: var(--shadow-card, 0 1px 3px rgba(0, 0, 0, 0.03));
  }

  .side-card-accent {
    background-color: var(--color-surface-hover);
    border-color: rgba(232, 88, 28, 0.25);
  }

  .side-card-accent:hover {
    border-color: rgba(232, 88, 28, 0.25);
  }

  .side-card-title {
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-semibold, 600);
    color: var(--color-text);
    margin: 0 0 var(--space-4, 1rem) 0;
    border-bottom: 1px solid var(--color-border-subtle, var(--color-border));
    padding-bottom: var(--space-2, 0.5rem);
  }

  .side-card-body {
    display: flex;
    flex-direction: column;
  }

  .side-card-body :global(ul) {
    list-style: disc;
    padding-left: 1.15rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .side-card-body :global(li) {
    color: var(--color-text-secondary);
    font-size: var(--text-sm, 0.875rem);
    line-height: 1.45;
  }

  .side-card-body :global(li::marker) {
    color: var(--color-text-muted);
  }

  .side-card-body :global(li .side-card-sub) {
    display: block;
    font-size: var(--text-xs, 0.75rem);
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }
</style>
