---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../cards/ProjectCard.astro';
import Button from '../ui/Button.astro';
import { getLighthouseProjects } from '../../utils/projects';

interface Props {
  projects: CollectionEntry<'projects'>[];
  title: string;
  featuredProjectIds?: string[];
}

const { projects, title, featuredProjectIds } = Astro.props;
const lighthouseProjects = getLighthouseProjects(projects, featuredProjectIds);
---

<section class="page-section" id="projekte">
  <div class="section-container">
    <div class="section-header">
      <h2>{title}</h2>
    </div>

    <div class="projects-grid">
      {lighthouseProjects.map((p) => (
        <div class="card-wrapper">
          <ProjectCard project={p} scope="internal" />
        </div>
      ))}
    </div>

    <div class="center-actions">
      <Button href="/projekte" variant="outline" size="md">
        Alle Projekte und Ideen anzeigen
      </Button>
    </div>
  </div>
</section>
