---
import type { CollectionEntry } from 'astro:content';

interface Props {
  participation?: any;
  openLabEvent?: CollectionEntry<'events'>;
  hacktEvent?: CollectionEntry<'events'>;
  calendarFeedUrl: string;
  contactMail: string;
}

const { participation, openLabEvent, hacktEvent, calendarFeedUrl, contactMail } = Astro.props;
const regularEvents = [openLabEvent, hacktEvent].filter((e): e is CollectionEntry<'events'> =>
  Boolean(e)
);
const showSection = Boolean(
  participation && (participation.title || (participation.ways && participation.ways.length > 0))
);
---

{showSection && (
  <section class="page-section" id="mitmachen">
    <div class="section-container">
      {participation.title && (
        <header>
          <h2>{participation.title}</h2>
          {participation.lead && <p>{participation.lead}</p>}
        </header>
      )}

      {participation.ways && participation.ways.length > 0 && (
        <div class="two-col participation-ways">
          {participation.ways.map((way: any) => (
            <div class="partner-box">
              {way.title && <h3>{way.title}</h3>}
              {way.desc && <p>{way.desc}</p>}
            </div>
          ))}
        </div>
      )}

      <div class="contact-card" id="treffen">
        <div class="contact-info" id="kontakt">
          <div class="info-group">
            <div class="info-label">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              Treffpunkte vor Ort
            </div>
            <div class="info-text">
              {regularEvents.map((ev, idx) => (
                <p class={idx > 0 ? 'meeting-gap' : undefined}>
                  <strong>{ev.data.title}</strong>
                  {ev.data.rhythm && (
                    <>
                      <br />
                      {ev.data.rhythm}
                    </>
                  )}
                  {ev.data.location && (
                    <>
                      <br />
                      {ev.data.locationUrl ? (
                        <a
                          href={ev.data.locationUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-subtle"
                        >
                          <span>{ev.data.location}</span> <span class="link-arrow">🡵</span>
                        </a>
                      ) : (
                        <span>{ev.data.location}</span>
                      )}
                    </>
                  )}
                  {ev.data.registrationUrl && (
                    <span>
                      {' '}
                      <br />{' '}
                      <a
                        href={ev.data.registrationUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-inline"
                      >
                        <span>Kostenfrei auf Pretix anmelden</span>{' '}
                        <span class="link-arrow">🡵</span>
                      </a>
                    </span>
                  )}
                </p>
              ))}
              <p class="sub-note">Online-Teilnahme auf Anfrage möglich.</p>
              <p class="calendar-note">
                Alle Termine im{' '}
                <a href="/events" class="link-inline">
                  Termin-Kalender
                </a>{' '}
                oder als{' '}
                <a
                  href={calendarFeedUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-inline"
                >
                  <span>iCal-Abonnement</span> <span class="link-arrow">🡵</span>
                </a>
                .
              </p>
            </div>
          </div>

          {contactMail && (
            <div class="info-group">
              <div class="info-label">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
                E-Mail Kontakt
              </div>
              <div class="info-text">
                <p>
                  <a href={`mailto:${contactMail}`} class="link-subtle">
                    {contactMail}
                  </a>
                </p>
              </div>
            </div>
          )}
        </div>

        <div class="map-wrapper">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=8.3995%2C49.0040%2C8.4095%2C49.0150&layer=mapnik&marker=49.0092744%2C8.4078973"
            loading="lazy"
            title="Standort OK Lab Karlsruhe"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  h2 {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  header p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
  }

  .participation-ways {
    margin-bottom: 2.5rem;
  }

  .partner-box {
    background: var(--color-surface);
    border-radius: 12px;
    padding: 2rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .partner-box p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 5rem;
  }

  .info-group {
    margin-bottom: 1.5rem;
  }

  .info-group:last-child {
    margin-bottom: 0;
  }

  .info-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .info-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: 1.5rem;
  }

  .info-text p {
    margin: 0 0 0.5rem 0;
  }

  .meeting-gap {
    margin-top: 1rem !important;
  }

  .sub-note {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem !important;
  }

  .calendar-note {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-top: 1rem !important;
  }

  .map-wrapper {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-height: 260px;
  }

  iframe {
    width: 100%;
    height: 100%;
    min-height: 260px;
    border: none;
    display: block;
  }

  @media (max-width: 900px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-card {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
    }
  }
</style>
