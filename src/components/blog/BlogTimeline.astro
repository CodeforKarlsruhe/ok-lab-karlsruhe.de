---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPostCard from './BlogPostCard.astro';
import ArrowRight from '../ui/ArrowRight.astro';
import {
  getBlogPostsForEntity,
  loadBlogContext,
  resolveBlogMeta,
  type BlogContext,
} from '../../utils/blog';

interface Props {
  posts?: CollectionEntry<'blog'>[];
  ctx?: BlogContext;
  entityType?: 'project' | 'event' | 'dataset';
  entityId?: string;
  heading?: string;
}

const { posts, ctx, entityType, entityId, heading } = Astro.props;

let feedPosts: CollectionEntry<'blog'>[] = posts ?? [];
if (!posts && entityType && entityId) {
  const allPosts = await getCollection('blog');
  feedPosts = getBlogPostsForEntity(allPosts, entityType, entityId);
}

const blogCtx = feedPosts.length > 0 ? (ctx ?? (await loadBlogContext())) : null;
const WrapperTag = heading ? 'section' : 'div';
---

{feedPosts.length > 0 ? (
  <WrapperTag class={heading ? 'related-section blog-mini-feed' : undefined}>
    {heading && (
      <div class="related-header">
        <h2>{heading}</h2>
        <a href="/blog" class="link-action">
          <span>Alle Beiträge</span>
          <ArrowRight />
        </a>
      </div>
    )}
    <div class="timeline-feed">
      {feedPosts.map((post) => {
        const meta = resolveBlogMeta(post, blogCtx!);
        return (
          <div class="timeline-item">
            <div class="timeline-rail" aria-hidden="true">
              <span class="timeline-dot"></span>
            </div>
            <div class="timeline-content">
              <BlogPostCard
                post={post}
                author={meta.author}
                linkedProjects={meta.linkedProjects}
                linkedEvents={meta.linkedEvents}
                linkedDatasets={meta.linkedDatasets}
                formattedDate={meta.formattedDate}
                discussionUrl={meta.discussionUrl}
                mode="feed"
              />
            </div>
          </div>
        );
      })}
    </div>
  </WrapperTag>
) : (
  !entityType && <p class="empty-feed">Noch keine Beiträge vorhanden.</p>
)}

<style>
  .timeline-feed {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 1rem;
    position: relative;
  }

  .timeline-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .timeline-rail::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: -1.75rem;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item:last-child .timeline-rail::before {
    display: none;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-primary-light);
    margin-top: 1.35rem;
    z-index: 1;
  }

  .empty-feed {
    color: var(--color-text-muted);
    text-align: center;
    padding: 3rem 1rem;
  }

  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1fr;
    }

    .timeline-rail {
      display: none;
    }
  }
</style>
