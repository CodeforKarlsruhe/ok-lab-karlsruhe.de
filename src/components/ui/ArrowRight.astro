---
interface Props {
  class?: string;
  size?: number | string;
  [key: string]: any;
}

const { class: className = 'link-arrow', size = 14, ...rest } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  {...rest}
>
  <path d="M5 12h14"></path>
  <path d="m12 5 7 7-7 7"></path>
</svg>
