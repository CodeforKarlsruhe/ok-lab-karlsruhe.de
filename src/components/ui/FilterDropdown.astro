---
export interface FilterDropdownOption {
  id: string;
  label: string;
  name?: string;
}

interface Props {
  id: string;
  label: string;
  options: FilterDropdownOption[];
  activeValue?: string;
  searchPlaceholder?: string;
  searchAriaLabel?: string;
  iconPath?: string;
  menuRight?: boolean;
  selectedSpanId?: string;
  menuId?: string;
  wrapClass?: string;
}

const {
  id,
  label,
  options,
  activeValue,
  searchPlaceholder = `${label} filtern…`,
  searchAriaLabel = `${label} durchsuchen`,
  iconPath,
  menuRight = false,
  selectedSpanId = `selected-${id}`,
  menuId = `menu-dropdown-${id}`,
  wrapClass = '',
} = Astro.props;
---

<div class:list={['filter-dropdown-wrap', wrapClass]} data-group-id={id} id={`dropdown-wrap-${id}`}>
  <button
    type="button"
    class="group-dropdown-btn"
    id={`btn-dropdown-${id}`}
    aria-haspopup="listbox"
    aria-expanded="false"
    data-group-id={id}
  >
    {iconPath && (
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={iconPath}
      />
    )}
    <span class="group-btn-label">{label}</span>
    <span class="group-btn-selected hidden" id={selectedSpanId}></span>
    <svg
      class="dropdown-chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>

  <div class:list={['group-dropdown-menu', { 'menu-right': menuRight }]} id={menuId} role="listbox">
    <div class="dropdown-search-wrap">
      <svg
        class="dropdown-search-icon"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        type="search"
        class="dropdown-search-input"
        placeholder={searchPlaceholder}
        aria-label={searchAriaLabel}
        autocomplete="off"
      />
    </div>

    <div class="dropdown-options-list" id={`options-${id}`}>
      {options.map((opt, idx) => {
        const isSelected = activeValue ? opt.id === activeValue : idx === 0;
        return (
          <button
            type="button"
            class:list={['dropdown-option', { active: isSelected }]}
            data-group={id}
            data-val={opt.id}
            data-name={opt.name}
            role="option"
            aria-selected={isSelected ? 'true' : 'false'}
          >
            <span>{opt.label}</span>
            <svg
              class="opt-check"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </button>
        );
      })}
      <div class="dropdown-no-match hidden">Keine Treffer</div>
    </div>
  </div>
</div>

<script>
  function setupGroupedDropdowns() {
    document.querySelectorAll('.filter-dropdown-wrap').forEach((wrap) => {
      if ((wrap as any).__dropdownInit) return;
      (wrap as any).__dropdownInit = true;

      const btn = wrap.querySelector('.group-dropdown-btn') as HTMLButtonElement | null;
      const searchInput = wrap.querySelector('.dropdown-search-input') as HTMLInputElement | null;
      const options = wrap.querySelectorAll('.dropdown-option') as NodeListOf<HTMLButtonElement>;
      const noMatch = wrap.querySelector('.dropdown-no-match') as HTMLElement | null;
      const labelSpan = wrap.querySelector('.group-btn-label') as HTMLElement | null;
      const selectedSpan = wrap.querySelector('.group-btn-selected') as HTMLElement | null;

      const baseLabel = labelSpan?.textContent || '';

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = wrap.classList.contains('is-open');

        document.querySelectorAll('.filter-dropdown-wrap.is-open').forEach((other) => {
          if (other !== wrap) {
            other.classList.remove('is-open');
            other.querySelector('.group-dropdown-btn')?.setAttribute('aria-expanded', 'false');
          }
        });

        if (!isOpen) {
          wrap.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          if (searchInput) {
            searchInput.value = '';
            options.forEach((opt) => (opt.style.display = 'flex'));
            noMatch?.classList.add('hidden');
            setTimeout(() => searchInput.focus(), 60);
          }
        } else {
          wrap.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });

      searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        let matchCount = 0;
        options.forEach((opt) => {
          const text = (opt.textContent || '').toLowerCase();
          const matches = !query || text.includes(query);
          opt.style.display = matches ? 'flex' : 'none';
          if (matches) matchCount++;
        });
        if (noMatch) {
          noMatch.classList.toggle('hidden', matchCount > 0);
        }
      });

      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          wrap.classList.remove('is-open');
          btn?.setAttribute('aria-expanded', 'false');
          btn?.focus();
        }
      });

      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          options.forEach((o) => {
            o.classList.remove('active');
            o.setAttribute('aria-selected', 'false');
          });
          opt.classList.add('active');
          opt.setAttribute('aria-selected', 'true');

          const val = opt.dataset.val || 'Alle';
          const groupId = opt.dataset.group || '';

          if (val === 'Alle' || val === 'all') {
            btn?.classList.remove('has-selection');
            if (labelSpan) labelSpan.textContent = baseLabel;
            if (selectedSpan) {
              selectedSpan.textContent = '';
              selectedSpan.classList.add('hidden');
            }
          } else {
            btn?.classList.add('has-selection');
            if (labelSpan) labelSpan.textContent = `${baseLabel}:`;
            if (selectedSpan) {
              selectedSpan.textContent = opt.querySelector('span')?.textContent || val;
              selectedSpan.classList.remove('hidden');
            }
          }

          wrap.classList.remove('is-open');
          btn?.setAttribute('aria-expanded', 'false');

          wrap.dispatchEvent(
            new CustomEvent('filter-change', {
              bubbles: true,
              detail: { group: groupId, value: val },
            })
          );
        });
      });
    });

    if (!(window as any).__filterDropdownDocListeners) {
      (window as any).__filterDropdownDocListeners = true;
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement)?.closest('.filter-dropdown-wrap')) {
          document.querySelectorAll('.filter-dropdown-wrap.is-open').forEach((wrap) => {
            wrap.classList.remove('is-open');
            wrap.querySelector('.group-dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.filter-dropdown-wrap.is-open').forEach((wrap) => {
            wrap.classList.remove('is-open');
            wrap.querySelector('.group-dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }
  }

  setupGroupedDropdowns();
  document.addEventListener('astro:page-load', setupGroupedDropdowns);
</script>

<style>
  .filter-dropdown-wrap {
    position: relative;
  }

  .group-dropdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 32px;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-md, 6px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
    box-sizing: border-box;
    transition:
      border-color 0.15s,
      background-color 0.15s,
      color 0.15s;
  }

  .group-dropdown-btn:hover,
  .filter-dropdown-wrap.is-open .group-dropdown-btn {
    border-color: var(--color-border-hover);
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  .group-dropdown-btn.has-selection {
    background: var(--color-primary-light, rgba(232, 88, 28, 0.08));
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  .group-btn-selected {
    font-weight: 600;
  }

  .group-btn-selected.hidden {
    display: none;
  }

  .dropdown-chevron {
    transition: transform 180ms ease;
    opacity: 0.75;
  }

  .filter-dropdown-wrap.is-open .dropdown-chevron {
    transform: rotate(180deg);
  }

  .group-dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 200px;
    max-width: 280px;
    background: var(--color-surface-raised, #ffffff);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 6px);
    box-shadow: var(--shadow-popover);
    z-index: 60;
    display: none;
    flex-direction: column;
    overflow: hidden;
    animation: fadeInDropdown 150ms ease-out;
  }

  :global(.search-mode-right) .group-dropdown-menu,
  :global(.filter-row-right) .group-dropdown-menu,
  .group-dropdown-menu.menu-right {
    left: auto;
    right: 0;
  }

  @keyframes fadeInDropdown {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .filter-dropdown-wrap.is-open .group-dropdown-menu {
    display: flex;
  }

  .dropdown-search-wrap {
    position: relative;
    padding: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .dropdown-search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .dropdown-search-input {
    width: 100%;
    height: 32px;
    padding: 0 0.65rem 0 1.85rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    font-size: 0.78rem;
    outline: none;
    transition: border-color 150ms ease;
  }

  .dropdown-search-input:focus {
    border-color: var(--color-primary);
  }

  .dropdown-options-list {
    max-height: 240px;
    overflow-y: auto;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dropdown-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    text-align: left;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 120ms ease;
    width: 100%;
  }

  .dropdown-option:hover {
    background: var(--color-surface-hover, rgba(0, 0, 0, 0.04));
  }

  .dropdown-option.active {
    background: var(--color-primary-light, rgba(232, 88, 28, 0.08));
    color: var(--color-primary);
    font-weight: 600;
  }

  .opt-check {
    opacity: 0;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .dropdown-option.active .opt-check {
    opacity: 1;
  }

  .dropdown-no-match {
    padding: 0.75rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .dropdown-no-match.hidden {
    display: none;
  }
</style>
