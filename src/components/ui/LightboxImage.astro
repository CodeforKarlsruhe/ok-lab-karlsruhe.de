---
import ImageMetaBadge from './ImageMetaBadge.astro';

interface Props {
  src: string;
  alt?: string;
  caption?: string | null;
  metaAlt?: string | null;
  metadata?: string | null;
  copyright?: string | null;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  dataFallback?: string;
}

const {
  src,
  alt = '',
  caption,
  metaAlt,
  metadata,
  copyright,
  imgClass = '',
  loading,
  dataFallback,
} = Astro.props;

const resolvedCaption = (caption || copyright || metadata || metaAlt || alt || '').trim();
---

<img
  src={src}
  alt={alt}
  class={imgClass}
  loading={loading}
  data-lightbox="true"
  data-caption={resolvedCaption}
  data-fallback={dataFallback}
/>
<ImageMetaBadge imageAlt={metaAlt} metadata={metadata} copyright={copyright} imageSrc={src} />

<script>
  function isEligibleMarkdownImg(img: HTMLImageElement): boolean {
    const src = (img.getAttribute('src') || '').split('?')[0].split('#')[0].toLowerCase().trim();
    if (!src || src.endsWith('.svg')) return false;
    if (img.closest('a, h1, h2, h3, h4, h5, h6')) return false;
    return true;
  }

  function getPageLightboxImages(): HTMLImageElement[] {
    const explicit = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-lightbox]'));
    const markdownImgs = Array.from(
      document.querySelectorAll<HTMLImageElement>('.markdown-body img')
    ).filter(isEligibleMarkdownImg);

    const seen = new Set<HTMLImageElement>();
    const result: HTMLImageElement[] = [];
    [...explicit, ...markdownImgs].forEach((img) => {
      if (seen.has(img)) return;
      seen.add(img);
      if (img.offsetParent !== null || img.getClientRects().length > 0) {
        result.push(img);
      }
    });
    return result;
  }

  function initLightboxGallery() {
    document.querySelectorAll<HTMLImageElement>('.markdown-body img').forEach((img) => {
      if (isEligibleMarkdownImg(img)) {
        img.setAttribute('data-lightbox-md', 'true');
      }
    });

    if ((window as any).__oklabLightboxInit) return;
    (window as any).__oklabLightboxInit = true;

    const modal = document.createElement('div');
    modal.id = 'oklab-lightbox';
    modal.className = 'lightbox-overlay';
    modal.setAttribute('role', 'dialog');
    modal.setAttribute('aria-modal', 'true');
    modal.setAttribute('aria-hidden', 'true');
    modal.setAttribute('aria-label', 'Bildergalerie');
    modal.innerHTML = `
      <div class="lightbox-topbar">
        <span class="lightbox-counter" id="lightbox-counter"></span>
        <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Schließen">×</button>
      </div>
      <div class="lightbox-stage" id="lightbox-stage">
        <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Vorheriges Bild">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <figure class="lightbox-figure">
          <img id="lightbox-img" class="lightbox-img" src="" alt="" />
          <figcaption id="lightbox-caption" class="lightbox-caption"></figcaption>
        </figure>
        <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Nächstes Bild">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    `;
    document.body.appendChild(modal);

    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement;
    const captionEl = document.getElementById('lightbox-caption') as HTMLElement;
    const counterEl = document.getElementById('lightbox-counter') as HTMLElement;
    const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;
    const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;
    const stageEl = document.getElementById('lightbox-stage') as HTMLElement;

    let items: HTMLImageElement[] = [];
    let currentIdx = 0;
    let touchStartX = 0;

    function getCaption(img: HTMLImageElement): string {
      const raw = (img.dataset.caption || img.alt || '').trim();
      return /^alias=/.test(raw) ? '' : raw;
    }

    function showSlide(idx: number) {
      if (items.length === 0) return;
      currentIdx = (idx + items.length) % items.length;
      const target = items[currentIdx];
      imgEl.src = target.currentSrc || target.src;
      imgEl.alt = getCaption(target);

      const cap = getCaption(target);
      captionEl.textContent = cap;
      captionEl.classList.toggle('hidden', !cap);

      const multi = items.length > 1;
      prevBtn.classList.toggle('hidden', !multi);
      nextBtn.classList.toggle('hidden', !multi);
      counterEl.textContent = multi ? `${currentIdx + 1} / ${items.length}` : '';
    }

    function openAt(clicked: HTMLImageElement) {
      items = getPageLightboxImages();
      const idx = items.indexOf(clicked);
      if (idx === -1) items = [clicked];
      showSlide(idx === -1 ? 0 : idx);
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target || target.closest('.image-meta-badge')) return;
      const clickedImg = target.closest<HTMLImageElement>(
        'img[data-lightbox], img[data-lightbox-md]'
      );
      if (clickedImg) {
        e.preventDefault();
        openAt(clickedImg);
      }
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(currentIdx - 1);
    });
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(currentIdx + 1);
    });

    stageEl.addEventListener('click', (e) => {
      if (e.target === stageEl) close();
    });

    modal.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0]?.clientX || 0;
      },
      { passive: true }
    );

    modal.addEventListener(
      'touchend',
      (e) => {
        const dx = (e.changedTouches[0]?.clientX || 0) - touchStartX;
        if (Math.abs(dx) > 40 && items.length > 1) {
          showSlide(currentIdx + (dx < 0 ? 1 : -1));
        }
      },
      { passive: true }
    );

    window.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft' && items.length > 1) showSlide(currentIdx - 1);
      else if (e.key === 'ArrowRight' && items.length > 1) showSlide(currentIdx + 1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightboxGallery);
  } else {
    initLightboxGallery();
  }
  document.addEventListener('astro:page-load', initLightboxGallery);
</script>

<style is:global>
  img[data-lightbox],
  img[data-lightbox-md] {
    cursor: zoom-in;
  }

  #oklab-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: rgba(16, 15, 14, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    flex-direction: column;
    color: #ffffff;
  }

  #oklab-lightbox.is-open {
    display: flex;
  }

  #oklab-lightbox .lightbox-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    flex-shrink: 0;
  }

  #oklab-lightbox .lightbox-counter {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    font-variant-numeric: tabular-nums;
  }

  #oklab-lightbox .lightbox-close {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  #oklab-lightbox .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  #oklab-lightbox .lightbox-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0.5rem 4rem 1.5rem;
  }

  #oklab-lightbox .lightbox-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    max-height: 100%;
  }

  #oklab-lightbox .lightbox-img {
    max-width: 90vw;
    max-height: calc(100vh - 150px);
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  #oklab-lightbox .lightbox-caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    max-width: 70ch;
  }

  #oklab-lightbox .lightbox-caption.hidden,
  #oklab-lightbox .lightbox-nav.hidden {
    display: none;
  }

  #oklab-lightbox .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  #oklab-lightbox .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  #oklab-lightbox .lightbox-prev {
    left: 1rem;
  }

  #oklab-lightbox .lightbox-next {
    right: 1rem;
  }

  @media (max-width: 640px) {
    #oklab-lightbox .lightbox-stage {
      padding: 0.5rem 0.75rem 1.25rem;
    }

    #oklab-lightbox .lightbox-img {
      max-width: 94vw;
    }

    #oklab-lightbox .lightbox-nav {
      width: 36px;
      height: 36px;
    }

    #oklab-lightbox .lightbox-prev {
      left: 0.5rem;
    }

    #oklab-lightbox .lightbox-next {
      right: 0.5rem;
    }
  }
</style>
