---
import SplitHero from './SplitHero.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: string | null;
  imageAlt?: string;
  class?: string;
}

const { title, subtitle, image, imageAlt, class: className = '' } = Astro.props;
const metaAlt = imageAlt && imageAlt !== title ? imageAlt : null;
---

<SplitHero
  variant="detail"
  title={title}
  lead={subtitle}
  image={image}
  imageAlt={imageAlt}
  metaAlt={metaAlt}
  class={className}
>
  <slot />
</SplitHero>
