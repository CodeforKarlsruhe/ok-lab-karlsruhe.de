---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import FilterableGrid from '../../components/ui/FilterableGrid.astro';
import ProtocolCard from '../../components/cards/ProtocolCard.astro';
import { getCollection } from 'astro:content';

const protocols = await getCollection('protocols');
const projects = await getCollection('projects');

// Sort descending by date
const sortedProtocols = protocols.sort((a, b) => {
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  return dateB - dateA;
});

const protocolTypes = [
  { id: 'all', label: 'Alle Arten', active: true },
  { id: 'plenum', label: 'Plenum' },
  { id: 'vorstand', label: 'Vorstand' },
  { id: 'arbeitsgruppe', label: 'Arbeitsgruppe' },
  { id: 'mitgliederversammlung', label: 'Mitgliederversammlung' },
];
---

<Layout title="Protokolle" activeNav="protokolle">
  <main class="protocols-page">
    <PageHeader
      title="Protokolle"
      description="Alle öffentlichen Treffen, Beschlüsse und Arbeitsergebnisse des OK Lab Karlsruhe transparent dokumentiert."
    >
      <div
        class="header-actions"
        style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;"
      >
        <Button variant="outline" size="sm" href="/keystatic/collection/protocols" external>
          <svg
            slot="icon-left"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Protokoll in Keystatic verfassen</span>
          <span class="link-arrow">🡵</span>
        </Button>
      </div>
    </PageHeader>

    <div class="main-container">
      <FilterableGrid
        mode="flat"
        searchId="filter-search"
        searchPlaceholder="Protokolle durchsuchen..."
        searchAriaLabel="Protokolle durchsuchen"
        pills={protocolTypes}
        pillsId="type-filters"
        pillsDataAttr="data-type"
        gridId="protocols-grid"
        gridClass="cards-grid"
        emptyId="no-results"
        emptyTitle="Keine Protokolle gefunden"
        emptyDescription="Versuche es mit einem anderen Suchbegriff oder setze den Typ-Filter zurück."
        emptyResetId="btn-reset-protocols"
        emptyResetLabel="Filter zurücksetzen"
      >
        {sortedProtocols.map((proto) => (
          <ProtocolCard protocol={proto} projects={projects} />
        ))}
      </FilterableGrid>
    </div>
  </main>

  <script>
    function initProtocolsFilter() {
      const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
      const typeButtons = document.querySelectorAll('#type-filters .filter-pill');
      const cards = document.querySelectorAll('.protocol-card');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('btn-reset-protocols');

      let currentType = 'all';
      let currentQuery = '';

      function filterCards() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardEl = card as HTMLElement;
          const cardType = cardEl.getAttribute('data-type') || '';
          const cardSearch = (cardEl.getAttribute('data-search') || '').toLowerCase();

          const matchesType = currentType === 'all' || cardType === currentType;
          const matchesQuery = !currentQuery || cardSearch.includes(currentQuery);

          if (matchesType && matchesQuery) {
            cardEl.style.display = 'flex';
            visibleCount++;
          } else {
            cardEl.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
            noResults.style.display = 'flex';
          } else {
            noResults.classList.add('hidden');
            noResults.style.display = 'none';
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
          filterCards();
        });
      }

      typeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          typeButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentType = btn.getAttribute('data-type') || 'all';
          filterCards();
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentType = 'all';
          typeButtons.forEach((b, idx) => {
            b.classList.toggle('active', idx === 0);
          });
          filterCards();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProtocolsFilter);
    } else {
      initProtocolsFilter();
    }
    document.addEventListener('astro:page-load', initProtocolsFilter);
  </script>
</Layout>
