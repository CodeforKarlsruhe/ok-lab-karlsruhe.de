{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "scripts", "astro.config.mjs", "eslint.config.mjs"]
}
