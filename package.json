{
  "name": "oklab-home",
  "type": "module",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeforKarlsruhe/oklab-karlsruhe.de.git"
  },
  "packageManager": "pnpm@11.27.0",
  "description": "Website des OK Lab Karlsruhe — Wissensgraph & Community-Plattform",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro-check",
    "sync": "astro sync",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/netlify": "^6.6.5",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.7.4",
    "@keystatic/astro": "^5.0.3",
    "@keystatic/core": "^0.5.42",
    "astro": "^5.4.2",
    "fuse.js": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "@astrojs/markdown-remark": "^6.3.11"
  }
}
